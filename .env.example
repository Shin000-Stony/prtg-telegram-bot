NODE_ENV=production

TZ=Asia/Makassar

DATABASE_PATH=/data/prtg_bot.db

# PRTG API
PRTG_URL=https://PRTG_SERVER
PRTG_USERNAME=change_me
PRTG_PASSHASH=change_me
PRTG_DISCOVERY_INTERVAL=900

# Telegram
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# Monitoring Engine
POLL_INTERVAL=30
DOWN_CONFIRM_COUNT=2
RECOVERY_CONFIRM_COUNT=2
ALERTS_ENABLED=false
DEBUG_MONITORING=false

# Direct ICMP Fallback
DIRECT_PING_ENABLED=true
DIRECT_PING_TIMEOUT=3
DIRECT_PING_COUNT=3
DIRECT_PING_CONCURRENCY=8
