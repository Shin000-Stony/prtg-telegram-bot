NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Makassar

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_GLOBAL_GROUP_ID=

DATABASE_PATH=/data/prtg_bot.db

PRTG_BASE_URL=
PRTG_USERNAME=
PRTG_PASSHASH=
PRTG_TLS_REJECT_UNAUTHORIZED=false

# V6 Monitoring Engine (default disabled; set true AFTER V6 review approval)
MONITORING_ENABLED=false
PRTG_POLL_INTERVAL_MS=60000
ICMP_POLL_INTERVAL_MS=30000
ICMP_TIMEOUT_MS=3000
ICMP_CONCURRENCY=5

# V7 Alert Routing (default disabled; requires MONITORING_ENABLED=true)
ALERTS_ENABLED=false
ALERT_DISPATCH_INTERVAL_MS=1000
ALERT_MAX_EVENT_AGE_MS=900000
ALERT_MAX_ATTEMPTS=5